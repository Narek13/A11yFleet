<?xml version="1.0"?>
<ruleset name="A11yFleet">
    <description>WordPress.org-aligned coding standards for A11yFleet (modern PSR-4 / namespaced).</description>

    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>

    <!-- What to scan. -->
    <file>./a11yfleet.php</file>
    <file>./src</file>
    <file>./tests</file>
    <file>./uninstall.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/.ddev/*</exclude-pattern>

    <!--
        Base on the WordPress.org review standard, then drop only the sniffs
        that fight modern PSR-4 / namespaced OO code. All security, escaping,
        sanitisation and i18n rules (what the plugin review team checks) stay on.
    -->
    <rule ref="WordPress-Extra">
        <!-- PSR-4 file names (Foo.php) instead of class-foo.php. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Allow camelCase methods/properties (PSR style). -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
    </rule>

    <rule ref="WordPress-Docs">
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
        <!--
            Allow PHPStan/Psalm generic types (list<T>, array<K,V>) in @param/@return tags.
            The sniff would otherwise require the doc block to match the native "array" hint
            exactly, which prevents using the richer generic annotations that PHPStan needs.
        -->
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
    </rule>

    <!-- i18n: enforce a single text domain. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="a11yfleet"/>
            </property>
        </properties>
    </rule>

    <!-- Require prefixing of global symbols. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="a11yfleet"/>
                <element value="A11yFleet"/>
                <element value="A11YFLEET"/>
            </property>
        </properties>
    </rule>

    <!-- Minimum supported versions for compatibility checks. -->
    <config name="minimum_wp_version" value="6.4"/>
    <config name="testVersion" value="8.1-"/>
</ruleset>
