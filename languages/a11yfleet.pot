msgstr ""

#: src/Scanner/Rules/DocumentLanguageRule.php:69
msgid "Set the document language, e.g. <html lang=\"en\">. In WordPress, ensure the theme outputs language_attributes() on the <html> tag."
msgstr ""

#. translators: 1: the id value, 2: number of times it is used.
#: src/Scanner/Rules/DuplicateIdRule.php:73
#, php-format
msgid "The id \"%1$s\" is used %2$d times; ids must be unique."
msgstr ""

#: src/Scanner/Rules/DuplicateIdRule.php:78
msgid "Give each element a unique id, or use classes for shared styling/behaviour."
msgstr ""

#. translators: %s: the heading tag name, e.g. h2.
#: src/Scanner/Rules/EmptyHeadingRule.php:64
#, php-format
msgid "Heading <%s> is empty."
msgstr ""

#: src/Scanner/Rules/EmptyHeadingRule.php:68
msgid "Add text to the heading, or remove the empty heading element."
msgstr ""

#: src/Scanner/Rules/FormControlLabelRule.php:72
msgid "Form control has no associated label."
msgstr ""

#: src/Scanner/Rules/FormControlLabelRule.php:74
msgid "Add a <label for=\"…\"> tied to the field by id, wrap the field in a <label>, or add an aria-label / aria-labelledby."
msgstr ""

#. translators: 1: previous heading level, 2: current heading level.
#: src/Scanner/Rules/HeadingOrderRule.php:61
#, php-format
msgid "Heading level jumps from h%1$d to h%2$d, skipping a level."
msgstr ""

#: src/Scanner/Rules/HeadingOrderRule.php:66
msgid "Use heading levels in order (do not skip levels) so the document outline stays logical."
msgstr ""

#: src/Scanner/Rules/IframeTitleRule.php:67
msgid "iframe is missing a title attribute."
msgstr ""

#: src/Scanner/Rules/IframeTitleRule.php:69
msgid "Add a title attribute describing the embedded content, e.g. title=\"Location map\"."
msgstr ""

#: src/Scanner/Rules/ImageAltRule.php:69
msgid "Image is missing an alt attribute."
msgstr ""

#: src/Scanner/Rules/ImageAltRule.php:71
msgid "Add a descriptive alt attribute. For purely decorative images, use an empty alt=\"\"."
msgstr ""

#: src/Scanner/Rules/LinkTextRule.php:66
